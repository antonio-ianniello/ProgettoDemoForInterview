# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=user_management
POSTGRES_USER=user_management
POSTGRES_PASSWORD=           # scegli una password sicura
POSTGRES_PORT=5432

# Usato solo quando l'app gira FUORI da Docker (mvn spring-boot:run / IDE).
# Con Docker Compose il servizio app usa automaticamente il container postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/user_management
SPRING_DATASOURCE_USERNAME=user_management
SPRING_DATASOURCE_PASSWORD=  # stessa di POSTGRES_PASSWORD

# ─── Keycloak (realm pubblico già configurato) ────────────────────────────────
# Usa questi valori per il realm remoto fornito con il progetto.
KEYCLOAK_ISSUER_URI=https://idpgw.test4mind.com/realms/demo-interview
KEYCLOAK_OPENID_CONFIGURATION_URI=https://idpgw.test4mind.com/realms/demo-interview/.well-known/openid-configuration
# JWK URI usato dall'app per validare la firma del JWT
# IDE/dev locale: punta a localhost
# Docker: viene sovrascritto automaticamente dal compose con http://keycloak:8080/...
KEYCLOAK_JWK_SET_URI=https://idpgw.test4mind.com/realms/demo-interview/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=demo-task
KEYCLOAK_CLIENT_SECRET=      # fornito separatamente dal candidato — NON committare

# ─── Keycloak locale (opzionale — profilo "security") ─────────────────────────
# Alternativa al realm pubblico: avvia con `docker compose --profile security up`
# e configura manualmente realm/client/utenti (vedi README).
KEYCLOAK_LOCAL_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=     # scegli una password per la console admin locale
